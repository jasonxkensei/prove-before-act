{
  "name": "@xproof/xproof",
  "version": "0.1.11",
  "description": "Official SDK for the xProof blockchain certification API — proof and accountability layer for autonomous agents",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./vercel": {
      "import": {
        "types": "./dist/integrations/vercel.d.mts",
        "default": "./dist/integrations/vercel.mjs"
      },
      "require": {
        "types": "./dist/integrations/vercel.d.ts",
        "default": "./dist/integrations/vercel.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "xproof",
    "blockchain",
    "certification",
    "multiversx",
    "ai-agent",
    "accountability",
    "proof",
    "autonomous-agent"
  ],
  "author": "xProof",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonxkensei/xproof.git"
  },
  "homepage": "https://xproof.app",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "postcss": ">=8.5.10",
    "esbuild": ">=0.28.0"
  }
}
