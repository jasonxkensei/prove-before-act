# ===========================================
# xproof Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# Variables marked (required) must be set; others have sensible defaults.
# On Replit, variables prefixed with VITE_ are injected at build time into
# the client bundle — never put secrets in VITE_ variables.

# ----- Database (required) -----
DATABASE_URL=postgresql://user:password@host:5432/xproof
# Alternative: Neon serverless PostgreSQL connection string
# NEON_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/xproof
PGHOST=localhost
PGPORT=5432
PGUSER=xproof
PGPASSWORD=
PGDATABASE=xproof

# ----- Session (required) -----
SESSION_SECRET=your-session-secret-min-32-chars
# AUTH-M01: dedicated HMAC signing secret for outgoing webhooks. Must differ
# from SESSION_SECRET so a leaked webhook payload cannot be replayed to forge
# session cookies. Minimum 32 random characters.
WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret-min-32-chars

# ----- MultiversX Blockchain (required for certifications) -----
# Server-side transaction signing
MULTIVERSX_PRIVATE_KEY=your_hex_private_key
MULTIVERSX_SENDER_ADDRESS=erd1...
# Receiver wallet for certification fees (EGLD payments go here).
# This is the PRIMARY variable read by blockchain.ts, acp.ts, certifications.ts,
# and pricing.ts. You MUST set this — payment routing will fail silently otherwise.
MULTIVERSX_RECEIVER_ADDRESS=erd1...
# FE-H2: XPROOF_WALLET_ADDRESS is accepted as a secondary fallback in acp.ts,
# certifications.ts and pricing.ts (read after MULTIVERSX_RECEIVER_ADDRESS).
# PROOFMINT_WALLET_ADDRESS is a legacy alias only used in acp.ts as a third
# fallback. New deployments should use MULTIVERSX_RECEIVER_ADDRESS exclusively.
XPROOF_WALLET_ADDRESS=erd1...
# PROOFMINT_WALLET_ADDRESS=erd1...  # deprecated — use MULTIVERSX_RECEIVER_ADDRESS
# Network configuration (defaults shown)
MULTIVERSX_CHAIN_ID=1
MULTIVERSX_GATEWAY_URL=https://gateway.multiversx.com
MULTIVERSX_API_URL=https://api.multiversx.com

# ----- WalletConnect (required for web wallet login) -----
# Get a project ID at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# ----- x402 Pay-Per-Request Protocol -----
# EVM address (Base mainnet) that receives USDC payments.
# When set, unauthenticated requests to /api/proof and /api/batch return HTTP 402
# instead of 401, enabling the x402 pay-per-request flow.
X402_PAY_TO=0x...
# Optional overrides (defaults shown)
X402_PRICE_USD=0.01
# Format: "Human Label (eip155:CHAIN_ID)" — e.g. "Base (eip155:8453)"
X402_NETWORK_LABEL=Base (eip155:8453)
# RPC URL for the EVM chain used to verify x402 USDC payments
BASE_RPC_URL=https://mainnet.base.org

# ----- xMoney (EGLD payment gateway — alternative to direct MultiversX) -----
XMONEY_API_KEY=
XMONEY_SITE_ID=
XMONEY_WEBHOOK_SECRET=

# ----- Stripe (credit purchases) -----
STRIPE_SECRET_KEY=sk_live_...
VITE_STRIPE_PUBLIC_KEY=pk_live_...
# Testing keys (used in development/staging only)
TESTING_STRIPE_SECRET_KEY=sk_test_...
TESTING_VITE_STRIPE_PUBLIC_KEY=pk_test_...

# ----- Admin -----
# Comma-separated list of MultiversX wallet addresses with admin privileges.
# Admin wallets can confirm/reject violations, access /admin panel, and are
# exempt from certifications billing.
ADMIN_WALLETS=erd1...,erd1...

# ----- MX-8004 Trustless Agents Standard (optional) -----
# Smart contract addresses on MultiversX for the MX-8004 on-chain registries.
# Leave blank to disable MX-8004 integration.
MX8004_IDENTITY_REGISTRY=erd1qqq...
MX8004_REPUTATION_REGISTRY=erd1qqq...
MX8004_VALIDATION_REGISTRY=erd1qqq...
# Nonce of xproof's registered agent NFT in the identity registry
MX8004_XPROOF_AGENT_NONCE=1

# ----- Coherence divergence scanner -----
# How long (hours) before a WHY anchor without a linked WHAT is flagged divergent.
# Default: 2 hours.
COHERENCE_DIVERGENCE_TTL_HOURS=2

# ----- Rate-limit failure alerts -----
# Webhook URL for Slack/Discord alert when the DB-backed rate limiter fails open.
RL_FAIL_OPEN_ALERT_WEBHOOK_URL=https://hooks.slack.com/...
RL_FAIL_OPEN_ALERT_THRESHOLD=5
RL_FAIL_OPEN_ALERT_WINDOW_MINUTES=1
RL_FAIL_OPEN_ALERT_COOLDOWN_MINUTES=15

# ----- Blockchain transaction alerts -----
# Webhook URL for Slack/Discord alert when on-chain write failures exceed threshold.
TX_ALERT_WEBHOOK_URL=https://hooks.slack.com/...
TX_ALERT_THRESHOLD=3
TX_ALERT_WINDOW_MINUTES=15
TX_ALERT_COOLDOWN_MINUTES=15

# ----- Violation review queue alerts -----
# Alert when proposed violations have been waiting for admin review longer than
# VIOLATION_QUEUE_STALE_HOURS and the count exceeds VIOLATION_QUEUE_THRESHOLD.
# Checked once per daily maintenance cycle. Falls back to TX_ALERT_WEBHOOK_URL
# if VIOLATION_QUEUE_ALERT_WEBHOOK_URL is not set.
VIOLATION_QUEUE_ALERT_WEBHOOK_URL=https://hooks.slack.com/...
VIOLATION_QUEUE_THRESHOLD=10
VIOLATION_QUEUE_STALE_HOURS=24
VIOLATION_QUEUE_COOLDOWN_HOURS=24

# ----- Privacy / analytics -----
# Comma-separated SHA-256 hashes of IP addresses to exclude from visit tracking
# (e.g. your own office IP). Compute: echo -n "1.2.3.4" | sha256sum
EXCLUDE_IP_HASHES=

# ----- Replit (auto-populated on Replit — do not set manually) -----
REPL_ID=
REPL_SLUG=
REPL_OWNER=
REPLIT_DOMAINS=
REPLIT_DEV_DOMAIN=
# Set to "true" automatically by Replit in deployed (production) environments
REPLIT_DEPLOYMENT=
